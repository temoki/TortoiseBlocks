.DS_Store
xcuserdata/
*.xcuserstate
.build/
.swiftpm/
DerivedData/

# The local signing team — see Support/Signing.xcconfig.
Support/Local.xcconfig

# The App Store Connect API key. Like Support/Local.xcconfig, it stays local —
# CI reads it from a secret instead (see .github/workflows/appstore-metadata.yml).
*.p8

# The App Store previews, megabytes each: Tools/film/previews.rb writes them,
# Tools/appstore.rb sends them, and git never sees them.
appstore/previews/
