# Pushes the App Store listing that lives in appstore/ (#42).
#
# That is fastlane's whole job here: no building, no signing, no submitting.
# Builds reach TestFlight from Xcode Cloud on a v* tag, and these lanes never
# upload a binary — skip_binary_upload is on.
#
# iOS and macOS are separate versions in App Store Connect, so each takes its
# own run against its own screenshots directory. The text is shared: one
# directory of files per locale, which is deliver's own layout.

require_relative "metadata_check"

APP_IDENTIFIER = "space.hiraku.tortoiseblocks"

# Absolute, and deliberately so. deliver resolves a relative path against the
# repository root — its working directory — not against this file, so
# "../appstore/metadata" pointed one level above the checkout. It did not fail:
# it found no locales there, uploaded nothing, and reported success.
METADATA_PATH = File.expand_path("../appstore/metadata", __dir__)
SCREENSHOTS_ROOT = File.expand_path("../appstore/screenshots", __dir__)

platform :ios do
  desc "Diff the live iOS listing against appstore/metadata"
  lane :metadata_diff do
    diff_metadata(platform: "ios")
  end

  desc "Push appstore/ to the iOS listing"
  lane :metadata_push do
    push_metadata(platform: "ios", screenshots: "ios")
  end
end

platform :mac do
  desc "Diff the live macOS listing against appstore/metadata"
  lane :metadata_diff do
    diff_metadata(platform: "osx")
  end

  desc "Push appstore/ to the macOS listing"
  lane :metadata_push do
    push_metadata(platform: "osx", screenshots: "macos")
  end
end

desc "Check appstore/ without touching the network"
lane :metadata_check do
  check_metadata
end

# Credentials never live in the repository — the rule DEVELOPMENT_TEAM
# follows. Locally, a path to the .p8; in CI, its base64 in a secret, because
# a GitHub secret is one line and a PEM is not.
private_lane :asc_api_key do
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV["ASC_PRIVATE_KEY_PATH"],
    key_content: ENV["ASC_PRIVATE_KEY"],
    is_key_content_base64: !ENV["ASC_PRIVATE_KEY"].nil?
  )
end

# The same check CI runs on every pull request, so a push made by hand cannot
# skip it. deliver would catch a too-long subtitle as well, but only partway
# through the upload.
private_lane :check_metadata do
  UI.user_error!("appstore/ has problems — see above.") unless MetadataCheck.report
end

# force: true skips the HTML preview, which wants a human at a browser and so
# can never run unattended. What the preview would have shown is the diff of
# appstore/ — which is the reason the text is in the repository at all.
private_lane :push_metadata do |options|
  check_metadata

  # An empty or missing directory is the one failure deliver does not report:
  # it uploads nothing and says it succeeded. Refuse to run instead.
  screenshots_path = File.join(SCREENSHOTS_ROOT, options[:screenshots])
  [METADATA_PATH, screenshots_path].each do |path|
    locales = Dir.glob(File.join(path, "*")).select { |entry| File.directory?(entry) }
    UI.user_error!("No locale directories under #{path}") if locales.empty?
    UI.message("#{path}: #{locales.map { |l| File.basename(l) }.sort.join(', ')}")
  end

  deliver(
    api_key: asc_api_key,
    app_identifier: APP_IDENTIFIER,
    platform: options[:platform],
    metadata_path: METADATA_PATH,
    screenshots_path: screenshots_path,
    skip_binary_upload: true,
    skip_app_version_update: true,
    overwrite_screenshots: true,
    submit_for_review: false,
    automatic_release: false,
    run_precheck_before_submit: false,
    force: true
  )

  reconcile_screenshots(platform: options[:platform], screenshots: options[:screenshots])
end

# deliver leaves duplicate screenshots behind, reproducibly, on a first upload.
# It matches what is local against what is live by MD5, and Apple has not
# computed that checksum yet when deliver checks seven seconds after the PUT —
# so every image looks missing, deliver retries, and the set ends up with each
# picture twice. Its own upload step skips duplicates by the same checksum, and
# cannot, for the same reason.
#
# So the run does not end with deliver. This waits for the checksums to appear,
# drops the extra copies, puts the set in filename order, and fails if what is
# live still does not match what is on disk. It is the "check the listing, not
# the log" rule made into a step, after a push that reported success and had
# written nothing at all.
private_lane :reconcile_screenshots do |options|
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  version = app.get_edit_app_store_version(platform: CONNECT_PLATFORM.fetch(options[:platform]))

  version.get_app_store_version_localizations.each do |localization|
    local = Dir.glob(File.join(SCREENSHOTS_ROOT, options[:screenshots], localization.locale, "*.png")).sort
    next if local.empty?

    wanted = local.map { |path| [Digest::MD5.hexdigest(File.binread(path)), File.basename(path)] }

    localization.get_app_screenshot_sets.each do |set|
      # Apple fills sourceFileChecksum during processing; without it there is
      # nothing to compare and no way to tell a duplicate from an original.
      shots = nil
      120.times do
        shots = set.app_screenshots
        break if shots.all? { |shot| !shot.source_file_checksum.to_s.empty? }

        sleep(5)
        set = localization.get_app_screenshot_sets.find { |s| s.id == set.id }
      end

      seen = {}
      keep = []
      shots.each do |shot|
        checksum = shot.source_file_checksum
        if seen[checksum]
          UI.important("Removing duplicate #{shot.file_name}")
          shot.delete!
        else
          seen[checksum] = true
          keep << shot
        end
      end

      live = keep.map { |shot| [shot.source_file_checksum, shot.file_name] }
      unless live.sort == wanted.sort
        UI.user_error!(
          "#{localization.locale} #{set.screenshot_display_type}: App Store Connect has " \
          "#{live.map(&:last).sort.join(', ')} but appstore/ has #{wanted.map(&:last).sort.join(', ')}"
        )
      end

      ordered = wanted.map { |checksum, _| keep.find { |shot| shot.source_file_checksum == checksum } }
      set.reorder_screenshots(app_screenshot_ids: ordered.map(&:id))
      UI.success("#{localization.locale} #{set.screenshot_display_type}: #{ordered.count} screenshot(s), in order")
    end
  end
end

# deliver has no dry run for metadata: it either uploads, or shows an HTML page
# to a human. So the preview reads the listing itself, through the spaceship
# that fastlane already loads — field by field, which `deliver
# download_metadata` cannot do (it writes nothing at all for an empty listing,
# so a directory diff shows nothing to compare). Screenshots are not part of
# this; their diff is `git status` on appstore/screenshots.
VERSION_FIELDS = {
  "description.txt" => :description,
  "keywords.txt" => :keywords,
  "promotional_text.txt" => :promotional_text,
  "release_notes.txt" => :whats_new,
  "support_url.txt" => :support_url,
  "marketing_url.txt" => :marketing_url
}.freeze
APP_FIELDS = {
  "name.txt" => :name,
  "subtitle.txt" => :subtitle,
  "privacy_url.txt" => :privacy_policy_url
}.freeze

# deliver and spaceship do not share a vocabulary for the platforms: deliver
# takes "osx", the Connect API calls the same thing MAC_OS. The lanes speak
# deliver's, so the translation happens here.
CONNECT_PLATFORM = {
  "ios" => Spaceship::ConnectAPI::Platform::IOS,
  "osx" => Spaceship::ConnectAPI::Platform::MAC_OS
}.freeze

private_lane :diff_metadata do |options|
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)

  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("No app for #{APP_IDENTIFIER}") if app.nil?
  version = app.get_edit_app_store_version(platform: CONNECT_PLATFORM.fetch(options[:platform]))
  UI.user_error!("No editable #{options[:platform]} version — create one first") if version.nil?
  UI.message("#{options[:platform]} #{version.version_string} (#{version.app_store_state})")

  live = {}
  version.get_app_store_version_localizations.each do |localization|
    VERSION_FIELDS.each { |file, attribute| live[[localization.locale, file]] = localization.public_send(attribute).to_s }
  end
  app.fetch_edit_app_info&.get_app_info_localizations&.each do |localization|
    APP_FIELDS.each { |file, attribute| live[[localization.locale, file]] = localization.public_send(attribute).to_s }
  end

  changes = 0
  Dir.glob(File.join(METADATA_PATH, "*")).sort.each do |directory|
    next unless File.directory?(directory)

    locale = File.basename(directory)
    (VERSION_FIELDS.keys + APP_FIELDS.keys).sort.each do |file|
      path = File.join(directory, file)
      next unless File.exist?(path)

      local = File.read(path).strip
      remote = live[[locale, file]]
      next if remote == local

      changes += 1
      shown = ->(value) { value.nil? ? "(locale not on App Store Connect)" : (value.empty? ? "(empty)" : "#{value.lines.first.strip[0, 60]} [#{value.length}]") }
      UI.message("#{locale}/#{file}")
      UI.message("  - #{shown.call(remote)}")
      UI.message("  + #{shown.call(local)}")
    end
  end
  UI.success(changes.zero? ? "Nothing to change." : "#{changes} field(s) would change.")
end
